# npm run dev explicitly starts demo mode. Production refuses demo mode.
APP_MODE=supabase
PORT=3001
APP_ORIGIN=http://localhost:5173
# Supabase project URL and publishable/anon key (safe to expose to the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only: Supabase direct connection or session-mode pooler, never the anon key.
DATABASE_URL=
# CA certificate file for your provider if required; TLS verification stays enabled.
DATABASE_CA_FILE=
WORKSPACE_ID=
# Server-only, at least 32 random characters. Keep stable so invite links remain valid.
INVITE_SIGNING_SECRET=
# Development-only server JSON state; never use this adapter for production.
DEV_DATA_PATH=.data/dev-workspace.json
